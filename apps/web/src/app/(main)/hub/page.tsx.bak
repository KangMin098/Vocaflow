// apps/web/src/app/(main)/hub/page.tsx

import { Suspense } from 'react';
import Link from 'next/link';
import { redirect } from 'next/navigation';
import { createServerSupabaseClient } from '@/lib/supabase/server';
import { fetchHubData, type Activity } from '@/lib/supabase/queries';
import { HubHero } from '@/components/home/HubHero';
import { ModuleCard } from '@/components/home/ModuleCard';
import { ContinueCard } from '@/components/home/ContinueCard';
import {
  RecentActivity,
  type ActivityItem,
} from '@/components/dashboard/RecentActivity';
import { Skeleton } from '@/components/ui/Skeleton';

// queries.ts 의 Activity (학습 모듈만) → RecentActivity 의 ActivityItem 으로 매핑
const MODULE_LABEL: Record<Activity['module'], ActivityItem['module']> = {
  flashcard: 'Flashcard',
  spellforge: 'SpellForge',
  wordblitz: 'WordBlitz',
  scriptquiz: 'ScriptQuiz',
};

function toActivityItems(activities: Activity[]): ActivityItem[] {
  return activities.map((a) => ({
    id: a.id,
    module: MODULE_LABEL[a.module],
    action: a.score >= 80 ? '학습 완료' : '학습 시도',
    detail: a.textTitle,
    score: a.score,
    timeAgo: a.relativeTime,
  }));
}

export const metadata = {
  title: 'Hub · Vocaflow',
  description: '오늘의 학습을 시작하세요',
};

export const dynamic = 'force-dynamic';

export default async function HubPage() {
  const supabase = createServerSupabaseClient();
  const { data: { user } } = await supabase.auth.getUser();

  if (!user) {
    redirect('/login');
  }

  const hubData = await fetchHubData(supabase, user.id);

  return (
    <div className="flex flex-col gap-6 max-w-6xl mx-auto p-4 md:p-8">
      {/* ① Hero — 인사 + Streak + Today CTA + inline Stats */}
      <HubHero
        userName={hubData.userName}
        streak={hubData.streak}
        reviewCount={hubData.reviewCount}
        todayCount={hubData.todayCount}
        accuracy={hubData.accuracy}
      />

      {/* ② Module — 7모듈 빠른 진입 */}
      <section aria-label="학습 모듈">
        <h2 className="sr-only">학습 모듈</h2>
        <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3">
          <ModuleCard module="text"       lastStudiedAt={hubData.lastStudied.text}       />
          <ModuleCard module="wordvault"  lastStudiedAt={hubData.lastStudied.wordvault}  />
          <ModuleCard module="flashcard"  lastStudiedAt={hubData.lastStudied.flashcard}  />
          <ModuleCard module="spellforge" lastStudiedAt={hubData.lastStudied.spellforge} />
          <ModuleCard module="wordblitz"  lastStudiedAt={hubData.lastStudied.wordblitz}  />
          <ModuleCard module="scriptquiz" lastStudiedAt={hubData.lastStudied.scriptquiz} />
          <ModuleCard module="dashboard"  lastStudiedAt={hubData.lastStudied.dashboard}  />
        </div>
      </section>

      {/* ③ Continue — 이어하기 */}
      <section aria-label="이어하기">
        <h2 className="sr-only">이어하기</h2>
        {hubData.recentText ? (
          <ContinueCard
            textId={hubData.recentText.id}
            title={hubData.recentText.title}
            preview={hubData.recentText.preview}
            progressPercent={hubData.recentText.progressPercent}
            relativeTime={hubData.recentText.relativeTime}
            moduleLabel={hubData.recentText.moduleLabel}
          />
        ) : (
          <ContinueCardEmpty />
        )}
      </section>

      {/* ④ Reflection — 최근 학습 활동 (§13 재사용) */}
      <section aria-label="최근 학습 활동" className="
        bg-[var(--bg)] border border-[var(--bd)]
        rounded-[var(--r-lg)] shadow-[var(--sh-sm)]
        p-6 md:p-8
      ">
        <h2 className="font-display text-[18px] font-[600] text-[var(--t1)] mb-4">
          최근 학습 활동
        </h2>
        {hubData.activities.length > 0 ? (
          <Suspense fallback={<Skeleton className="h-48" />}>
            <RecentActivity activities={toActivityItems(hubData.activities)} />
          </Suspense>
        ) : (
          <p className="font-body text-[14px] text-[var(--t3)] py-8 text-center">
            아직 학습 활동이 없어요. 첫 학습을 시작해보세요.
          </p>
        )}
      </section>
    </div>
  );
}

// ─────────────────────────────────────────────────────────────
// ContinueCard 빈 상태 (Hub 전용 — 별도 컴포넌트화하지 않고 인라인)
// ─────────────────────────────────────────────────────────────
function ContinueCardEmpty() {
  return (
    <Link
      href="/text"
      className="group flex min-h-[180px] flex-col items-center justify-center gap-3 rounded-[var(--r-lg)] border-2 border-dashed border-[var(--bd)] bg-[var(--bg2)] p-8 transition-all duration-[var(--dur-normal)] ease-[var(--ease)] hover:border-[var(--p)] hover:bg-[var(--p-light)]"
    >
      <span className="text-[40px] leading-none" aria-hidden="true">📖</span>
      <p className="font-display text-[16px] font-[600] text-[var(--t1)]">
        아직 학습한 원문이 없어요
      </p>
      <span className="rounded-[var(--r-md)] bg-[var(--p)] px-4 py-2 font-display text-[13px] font-[600] text-[var(--ti)] transition-colors duration-[var(--dur-normal)] group-hover:bg-[var(--p-hover)]">
        원문 추가하기 →
      </span>
    </Link>
  );
}
