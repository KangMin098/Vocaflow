{
  "name": "vocaflow",
  "version": "1.0.0",
  "private": true,
  "description": "Vocaflow — 영어 원문 기반 종합 학습 플랫폼 모노레포",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:wlp": "pnpm --filter @vocaflow/wlp test",
    "format": "prettier --write .",
    "wt": "node scripts/worktree.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "sync:memory": "node scripts/sync-export-memory.mjs --refresh-context",
    "docs:db-stats": "node scripts/docs/gen-db-stats.mjs",
    "docs:db-stats:check": "node scripts/docs/gen-db-stats.mjs --check",
    "db:types": "npx supabase gen types typescript --linked > packages/types/src/database.ts",
    "db:push": "npx supabase db push",
    "db:diff": "npx supabase db diff --use-migra",
    "db:new": "npx supabase migration new",
    "db:seed-dictionary": "node --env-file=.env.local scripts/seed-dictionary.mjs",
    "db:seed-dictionary:dry": "node --env-file=.env.local scripts/seed-dictionary.mjs --dry-run",
    "db:dict:fetch": "node scripts/dict-fetch-batch.mjs",
    "db:dict:update": "node scripts/dict-update-batch.mjs",
    "db:dict:status": "node scripts/dict-status.mjs",
    "vcb:ingest": "tsx scripts/vcb/01-ingest.ts",
    "vcb:normalize": "tsx scripts/vcb/02-normalize.ts",
    "vcb:ingest-ai-seed": "tsx scripts/vcb/01b-ingest-ai-seed.ts",
    "vcb:validate-seed-list": "node scripts/vcb/01c-validate-seed-list.mjs",
    "vcb:extract": "tsx scripts/vcb/03-extract.ts",
    "vcb:dict-lookup": "tsx scripts/vcb/04-dict-lookup.ts",
    "vcb:export-job": "tsx scripts/vcb/05a-export-job.ts",
    "vcb:validate-output": "node scripts/vcb/05c-validate-output.mjs",
    "vcb:import-enriched": "tsx scripts/vcb/05d-import.ts",
    "vcb:qa": "tsx scripts/vcb/06-qa.ts",
    "vcb:curate": "tsx scripts/vcb/07-curate.ts",
    "vcb:publish": "tsx scripts/vcb/08-publish.ts",
    "vcb:publish-precheck": "tsx scripts/vcb/08b-publish-precheck.ts",
    "vcb:compose": "tsx --tsconfig apps/web/tsconfig.json scripts/vcb/compose-publish.mts",
    "vcb:compose-eval": "pnpm --filter web exec vitest run src/lib/vcb/compose",
    "ux:bench:competitors": "node scripts/ux-bench/bench.mjs --target competitors",
    "ux:bench:self": "node scripts/ux-bench/bench.mjs --target vocaflow",
    "ux:bench:compare": "node scripts/ux-bench/compare.mjs",
    "ux:bench:gate": "node scripts/ux-bench/gate.mjs",
    "ux:bench:selftest": "node scripts/ux-bench/score.selftest.mjs",
    "tcp:drain": "tsx --tsconfig apps/web/tsconfig.json scripts/topic-corpus/drain-loop.mts",
    "tbp:health": "tsx --tsconfig apps/web/tsconfig.json scripts/textbook/health-bundle.mts",
    "tbp:bench-report": "node scripts/textbook/gen-benchmark-report.mjs",
    "tbp:bench-report:check": "node scripts/textbook/gen-benchmark-report.mjs --check",
    "analytics:check": "node scripts/analytics/check-instrumentation.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KangMin098/Vocaflow.git"
  },
  "bugs": {
    "url": "https://github.com/KangMin098/Vocaflow/issues"
  },
  "homepage": "https://github.com/KangMin098/Vocaflow#readme",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@supabase/mcp-server-supabase": "0.10.0",
    "@supabase/supabase-js": "^2.104.1",
    "@types/node": "^25.9.0",
    "@vocaflow/library-pipeline": "workspace:*",
    "@vocaflow/vcb-core": "workspace:*",
    "@vocaflow/vcb-curate-core": "workspace:*",
    "@vocaflow/wlp": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "franc": "^6.2.0",
    "jimp": "^1.6.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "supabase": "^2.98.1",
    "tsx": "^4.22.1",
    "turbo": "^2.9.6",
    "xlsx": "^0.18.5"
  }
}
