{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm turbo run lint:*)",
      "Bash(pnpm turbo run typecheck:*)",
      "Bash(pnpm turbo run test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm --filter web lint:*)",
      "Bash(pnpm --filter web typecheck:*)",
      "Bash(pnpm --filter web test:*)",
      "Bash(pnpm --filter web exec vitest run:*)",
      "Bash(pnpm --filter web build:*)",
      "Bash(pnpm docs:db-stats:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(node agents/scripts/check.mjs:*)",
      "Bash(node agents/scripts/sync.mjs:*)",
      "Bash(node agents/scripts/lock.mjs:*)",
      "Bash(node agents/scripts/handoff.mjs:*)",
      "Bash(node --test agents/scripts/__tests__/*)",
      "Bash(pnpm build:*)",
      "Bash(git add:*)",
      "Bash(git worktree add:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(supabase db:*)",
      "Bash(psql:*)",
      "mcp__supabase__apply_migration",
      "mcp__claude_ai_Supabase__apply_migration"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(cat .env:*)",
      "Bash(cat .env.local:*)",
      "Bash(cat apps/web/.env.local:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/scripts/handoff-inject.mjs\" --agent claude",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/scripts/guard.mjs\" --agent claude",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/scripts/db-approval-hook.mjs\" --agent claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
