{
  "permissions": {
    "allow": [
      "mcp__ide__getDiagnostics",
      "Bash(npx tsc *)",
      "Bash(pnpm dev *)",
      "Bash(echo \"started PID $!\")",
      "Bash(curl -sf http://localhost:3000 -o /dev/null)",
      "Bash(curl -sS http://localhost:3003/text/1)",
      "Bash(curl -s -w \"\\\\nHTTP_STATUS:%{http_code}\\\\n\" http://localhost:3003/text/1)",
      "Bash(curl -s -o /dev/null -w \"status=%{http_code}\\\\n\" http://localhost:3003/text/1)",
      "Bash(pkill -f \"next dev\")",
      "Bash(pkill -f \"next-server\")",
      "Bash(pkill -f node)",
      "Bash(curl -s -o /dev/null -w \"hub=%{http_code}\\\\n\" http://localhost:3004/hub)",
      "Bash(curl -s -o /dev/null -w \"library=%{http_code}\\\\n\" http://localhost:3004/library)",
      "Bash(git check-ignore *)",
      "Bash(git add *)",
      "Bash(git reset *)"
    ]
  }
}
