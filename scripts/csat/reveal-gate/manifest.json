{
 "_note": "Reveal Gate Layer A — 학습자(anon · authenticated)가 닿는 CSAT 표면 전수 분류(2026-10-05 개발 DB · 저장소 실측). check-surfaces.mjs 가 DB · 저장소에서 다시 모아 여기 없는 표면이 있으면 실패한다. 손으로 늘리지 말고 새 표면이 생기면 분류 · gate 를 정한 뒤 넣는다.",
 "classes": {
  "PUBLIC_CONTENT": "정답 · 정오와 무관한 공개 내용",
  "LEARNER_OWN": "학습자 본인 입력 · 상태(정답 파생 아님)",
  "ANSWER_SENSITIVE": "정답 · 해설 · 근거 · 강의 · 파생 보고 — 활성 capture 시험이면 요청자 무관 보류",
  "CORRECTNESS": "점수 · 문항별 정오 · 정답 파생 통계 — 보류 + 학습자 직접 조회 회수(②)",
  "CORRECTNESS_ORACLE": "문자열 대신 성공/실패 · 응답 모양으로 정오가 드러날 수 있는 RPC — 행동 oracle 검사 대상",
  "CORRECTNESS_OWN_PRIOR": "학습자가 과거 연습에서 이미 본 정오(행 단위로 거를 수 없음) — 잔여 위험 O-3",
  "DERIVED_SECRET": "정답 역산 가능 해시 · 내부 파생값 — Pilot 무관 학습자 접근 영구 차단",
  "REVIEWER_INTERNAL": "배정된 판정자 전용 — 비관리자에게 보류 문항 마스킹",
  "ADMIN_ONLY": "관리자 · 큐레이터 전용(함수 · 정책 안에서 확인)",
  "OPS_META": "운영 메타(출처 · 적재 · 커버리지) — 문항 정답 없음",
  "TRIGGER_FN": "트리거 함수(직접 호출 의미 없음)"
 },
