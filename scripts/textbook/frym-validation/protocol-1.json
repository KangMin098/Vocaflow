{
  "version": 1,
  "description": "Small FYM educational validation pilot. Thresholds require a human study lead to preregister this exact protocol and measurement instruments before evaluation. These are design proposals, not measured grade norms.",
  "threshold_basis": "pilot_design_proposal_not_grade_norms",
  "minimum_experts": 2,
  "minimum_students_per_variant": 5,
  "minimum_items_per_axis": 3,
  "minimum_link_confidence": "high",
  "ranges": [
    {
      "grade": "middle_1",
      "reading_seconds": { "min": 0, "max": 300 },
      "comprehension_accuracy": { "min": 0.7, "max": 1 },
      "lexical_accuracy": { "min": 0.8, "max": 1 },
      "syntax_accuracy": { "min": 0.8, "max": 1 },
      "reasoning_accuracy": { "min": 0.6, "max": 1 },
      "unknown_word_fraction": { "min": 0, "max": 0.1 },
      "lexical_burden": { "min": 1, "max": 3 },
      "sentence_burden": { "min": 1, "max": 3 },
      "reasoning_burden": { "min": 1, "max": 3 },
      "perceived_difficulty": { "min": 1, "max": 3 }
    },
    {
      "grade": "high_1",
      "reading_seconds": { "min": 0, "max": 300 },
      "comprehension_accuracy": { "min": 0.7, "max": 1 },
      "lexical_accuracy": { "min": 0.8, "max": 1 },
      "syntax_accuracy": { "min": 0.8, "max": 1 },
      "reasoning_accuracy": { "min": 0.6, "max": 1 },
      "unknown_word_fraction": { "min": 0, "max": 0.1 },
      "lexical_burden": { "min": 1, "max": 3 },
      "sentence_burden": { "min": 1, "max": 3 },
      "reasoning_burden": { "min": 1, "max": 3 },
      "perceived_difficulty": { "min": 1, "max": 3 }
    }
  ]
}
