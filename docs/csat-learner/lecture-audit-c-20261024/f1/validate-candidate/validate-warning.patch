+// apps/web/src/lib/csat/lecture/__tests__/choice-pointing.test.ts
+import fs from 'node:fs'
+import path from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { checkChoicePointing, spokenHereChoices } from '../choice-pointing'
+import { lectureTargets } from '../targets'
+import type { Lecture } from '../types'
+import { validateLecture, type ValidateContext } from '../validate'
+
+const cue = (id: string, kind: string, tid: string, text: string) => ({ id, target: { kind, id: tid }, segments: [{ lang: 'ko-KR', text }] })
+
+describe('choice-pointing — 「여기 N 번 문장」 ↔ ⓝ 문장 anchor', () => {
+  it('선지 번호 가리키기만 센다', () => {
+    expect(spokenHereChoices('정답은 사 번. 여기 사 번 문장을 보세요.')).toEqual([4])
+    expect(spokenHereChoices('여기 세 번째 문장을 보세요.')).toEqual([])
+    expect(spokenHereChoices('사 번 문장을 가리고 이어 읽으세요.')).toEqual([])
+  })
+
+  it('ⓝ 문장과 다른 anchor 는 경고, 같으면 통과, 문맥 없으면 건너뜀', () => {
+    const m = { 4: 5 }
+    expect(checkChoicePointing([cue('c5', 'anchor', 'sentence:1', '여기 사 번 문장을 보세요.')], m)).toHaveLength(1)
+    expect(checkChoicePointing([cue('c5', 'anchor', 'sentence:5', '여기 사 번 문장을 보세요.')], m)).toHaveLength(0)
+    expect(checkChoicePointing([cue('c5', 'anchor', 'sentence:1', '여기 사 번 문장을 보세요.')], null)).toHaveLength(0)
+  })
+
+  it('실제 강의 35번: 확정 9 만 걸리고 정상 대조군 17 은 통과', () => {
+    // 선지→ⓝ 문장 index: csat_items.passage 를 문장 단위로 0부터 센 값(대량작업 C, 2026-10-24 SELECT) — 다섯 선지 전부
+    const map: Record<string, Record<number, number>> = JSON.parse(fs.readFileSync(path.join(__dirname, "choice-sentence-map-35.json"), "utf8")).map
+    const dir = path.resolve(__dirname, '../../lecture-data')
+    const lectures: Record<string, { cues: Parameters<typeof checkChoicePointing>[0] }> = {}
+    for (const f of fs.readdirSync(dir).filter((x) => x.endsWith('.json') && x !== 'index.json'))
+      Object.assign(lectures, JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8')).lectures)
+    const hit = Object.keys(map).filter((id) => checkChoicePointing(lectures[id].cues, map[id]).length > 0).sort()
+    expect(hit).toEqual(['2019#35', '2020#35', '2022#35', 'M1809#35', 'M2006#35', 'M2106#35', 'M2206#35', 'M2209#35', 'M2306#35'])
+  })
+
+  it('validateLecture: 경고는 warnings 에만 — ok · issues 는 choiceSentence 유무와 같다', () => {
+    const dir = path.resolve(__dirname, '../../lecture-data')
+    const lec = JSON.parse(fs.readFileSync(path.join(dir, 'M2106.json'), 'utf8')).lectures['M2106#35'] as Lecture
+    const base: ValidateContext = {
+      targets: lectureTargets({ answer: 4, answer_unknown: false, has_ability: true, has_intent: true, distractors: [1, 2, 3, 5], procedure_len: 3, vocab_len: 4, skeleton: { sentences: 12, placedAnchorIds: ['answer'] } }),
+      answer: 4, wrongChoices: [], hasTrapLabels: false, hasVocab: false, analysisTexts: [], sourceTexts: [],
+    }
+    const without = validateLecture(lec, base)
+    const withMap = validateLecture(lec, { ...base, choiceSentence: { 1: 3, 2: 4, 3: 5, 4: 6, 5: 7 } })
+    expect(withMap.ok).toBe(without.ok)
+    expect(withMap.issues).toEqual(without.issues)
+    expect(without.warnings).toBeUndefined()
+    expect(withMap.warnings?.map((w) => w.code)).toContain('pointing-choice')
+  })
+})
