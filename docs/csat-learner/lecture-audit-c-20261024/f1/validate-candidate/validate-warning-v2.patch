+    const dir = path.resolve(__dirname, '../../lecture-data')
+    const lectures: Record<string, { cues: Parameters<typeof checkChoicePointing>[0] }> = {}
+    for (const f of fs.readdirSync(dir).filter((x) => x.endsWith('.json') && x !== 'index.json'))
+      Object.assign(lectures, JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8')).lectures)
+    const hit = Object.keys(map).filter((id) => checkChoicePointing(lectures[id].cues, map[id]).length > 0).sort()
+    expect(hit).toEqual(['2019#35', '2020#35', '2022#35', 'M1809#35', 'M2006#35', 'M2106#35', 'M2206#35', 'M2209#35', 'M2306#35'])
+  })
+
+  it('validateLecture: 경고는 warnings 에만 — ok · issues 는 choiceSentence 유무와 같다', () => {
+    const dir = path.resolve(__dirname, '../../lecture-data')
+    const lec = JSON.parse(fs.readFileSync(path.join(dir, 'M2106.json'), 'utf8')).lectures['M2106#35'] as Lecture
+    const base: ValidateContext = {
+      targets: lectureTargets({ answer: 4, answer_unknown: false, has_ability: true, has_intent: true, distractors: [1, 2, 3, 5], procedure_len: 3, vocab_len: 4, skeleton: { sentences: 12, placedAnchorIds: ['answer'] } }),
+      answer: 4, wrongChoices: [], hasTrapLabels: false, hasVocab: false, analysisTexts: [], sourceTexts: [],
+    }
+    const without = validateLecture(lec, base)
+    const withMap = validateLecture(lec, { ...base, choiceSentence: { 1: 3, 2: 4, 3: 5, 4: 6, 5: 7 } })
+    expect(withMap.ok).toBe(without.ok)
+    expect(withMap.issues).toEqual(without.issues)
+    expect(without.warnings).toBeUndefined()
+    expect(withMap.warnings?.map((w) => w.code)).toContain('pointing-choice')
+  })
+})
+
+describe('choice-pointing v2 — 낱말 경계(P2) · 숫자 · v3 · 지문에서 표 만들기', () => {
+  it('낱말 경계 밖 · 붙여 쓴 「이번」은 세지 않고, 숫자 표기는 센다', () => {
+    expect(spokenHereChoices('기여기 사 번 문장을 보세요.')).toEqual([])
+    expect(spokenHereChoices('여기 사 번 문장부호를 보세요.')).toEqual([])
+    expect(spokenHereChoices('여기 이번 문장에서 확인하죠.')).toEqual([])
+    expect(spokenHereChoices('여기 이 번 문장을 보세요.')).toEqual([2])
+    expect(spokenHereChoices('여기 4번 문장을 보세요.')).toEqual([4])
+    expect(spokenHereChoices('여기, 오 번 문장.')).toEqual([5])
+  })
+
+  it('schema3 근거 문장(evidence, 1-기반)에 ⓝ 문장이 있으면 가리킨 것으로 본다', () => {
+    const c = { id: 'c4', target: { kind: 'v3', id: 'choice:4' }, segments: [{ lang: 'ko-KR', text: '여기 사 번 문장을 보세요.' }] }
+    expect(checkChoicePointing([{ ...c, evidence: [6] }], { 4: 5 })).toHaveLength(0)
+    expect(checkChoicePointing([{ ...c, evidence: [2] }], { 4: 5 })).toHaveLength(1)
