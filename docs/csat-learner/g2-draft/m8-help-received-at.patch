+    const csB = uuid()
+    const sB = (await sessI(uuid(), csB, 'g2#m8b', 'independent', '2026-10-08T10:01:00Z')).rows[0]
+    await sessI(uuid(), csB, 'g2#m8b', 'viewed_first', '2026-10-08T10:02:00Z')
