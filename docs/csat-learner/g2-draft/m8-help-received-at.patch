diff --git a/scripts/knowledge/build-g2-integrated.mjs b/scripts/knowledge/build-g2-integrated.mjs
index 190d0a801..ec7ddb374 100644
--- a/scripts/knowledge/build-g2-integrated.mjs
+++ b/scripts/knowledge/build-g2-integrated.mjs
@@ -235,6 +235,34 @@ s = s.slice(0, rbAt) + rollback + '\n'
   if (!s.includes(a3)) throw new Error('M7 a3')
   s = s.replace(a3, () => "  (a.synthetic or coalesce(s.synthetic, false)) as synthetic   -- M7 시도 · 세션 어느 쪽이든 합성이면 합성\n" + a2)
 }
+// M8 (사용자 결정 2026-10-08 · f5 재심사) 도움 노출 「시각」 으로 독립을 판정한다 — 세션의 도움 수준은 보수적으로 합치되(M5a′),
+// 도움을 받기 **전에** 낸 판단까지 비독립으로 바꾸지 않는다. 시도 행은 덮어쓰지 않고, 첫 시도 뷰가 판단 시각과 도움 받은 시각을 비교한다.
+{
+  const once = (name, a, b) => {
+    const n = s.split(a).length - 1
+    if (n !== 1) throw new Error(`M8 ${name}: ${n}곳`)
+    s = s.replace(a, () => b)
+  }
+  once('column',
+    '  explanation_viewed_at timestamptz,                               -- M1(B8) 판단 뒤 해설 열람 시각 — 먼저 정한 값 유지\n',
+    '  explanation_viewed_at timestamptz,                               -- M1(B8) 판단 뒤 해설 열람 시각 — 먼저 정한 값 유지\n' +
+      '  help_received_at timestamptz,                                    -- M8 처음 도움(viewed_first · hint)을 받은 가장 이른 시각 — 그 전 판단은 독립\n')
+  once('update',
+    '    explanation_viewed_at = least(s.explanation_viewed_at, p_explanation_viewed_at),  -- M1 · M5a 가장 이른 열람(least 는 NULL 을 건너뛴다)\n',
+    '    explanation_viewed_at = least(s.explanation_viewed_at, p_explanation_viewed_at),  -- M1 · M5a 가장 이른 열람(least 는 NULL 을 건너뛴다)\n' +
+      "    help_received_at = case when v_rank_new >= 1 and p_help_level in ('viewed_first', 'hint') then least(s.help_received_at, p_at) else s.help_received_at end,  -- M8 가장 이른 도움 시각(도착순 아님)\n")
+  const eff =
+    "case when s.id is null then a.help_level when s.help_received_at is not null and a.answered_at >= s.help_received_at then s.help_level else 'independent' end"
+  once('view help',
+    '  coalesce(s.help_level, a.help_level) as help_level,   -- M5b 실효 도움 수준(세션이 정본)\n',
+    `  ${eff} as help_level,   -- M5b · M8 실효 도움 수준 — 도움을 받은 시각 이후의 판단에만 세션 도움 수준(그 전 판단은 독립 · 시도 행은 덮지 않는다)\n`)
+  once('view viewed_first',
+    "  (coalesce(s.help_level, a.help_level) = 'viewed_first') as after_viewed_first,\n",
+    `  (${eff} = 'viewed_first') as after_viewed_first,\n`)
+  once('freeze',
+    '      or new.explanation_viewed_at is distinct from old.explanation_viewed_at)',
+    '      or new.explanation_viewed_at is distinct from old.explanation_viewed_at or new.help_received_at is distinct from old.help_received_at)  -- M8')
+}
 fs.writeFileSync(OUT, s)
 const outSha = crypto.createHash('sha256').update(s).digest('hex')
 console.log(JSON.stringify({ out: path.relative(ROOT, OUT), sha256: outSha, draft: DRAFT_SHA }))
