{
  "name": "csat-workspace-compact",
  "note": "기출 탐구 작업공간(/csat/item/[slug]) 컴팩트 기하 — 사용자 채택 목표(2026-10-13 설계 피드백)이며 원사이트(neon-currant.3b.dev) 실측값이 아니다. 원사이트 직접 측정은 미확보(README). CSS 변수 --csat-workspace-* 가 이 값을 쓴다(theater.module.css).",
  "source": "D:/workspace/vocaflow-csat-workspace-claude-instructions.md §3 기하 수용 기준",
  "tolerancePx": 2,
  "viewports": [1280, 1440],
  "railStates": [64, 220],
  "targets": {
    "dockItemHeight": 48,
    "dockHeight": 65,
    "frameHeadHeight": 44,
    "paneHeadHeight": 44,
    "paneGap": 10,
    "paneOuterPadding": 10,
    "paneBodyPadding": [14, 16],
    "dockNameFont": 11,
    "dockIcon": 13,
    "dockIconFace": 23,
    "questionFont": 17,
    "itemTitleFont": 13,
    "paneTitleFont": 12,
    "bodyFont": [13, 14],
    "bodyLineHeight": [1.7, 1.75],
    "paperFont": 15,
    "paperDefaultWidth": { "1280": [304, 320], "1440": [344, 360] },
    "evidenceExplainRatio": [0.33, 0.39],
    "minTarget": 44,
    "mainMinWidth": 712
  },
  "cssVars": {
    "--csat-workspace-dock-item": "dockItemHeight",
    "--csat-workspace-dock": "dockHeight",
    "--csat-workspace-head": "frameHeadHeight",
    "--csat-workspace-gap": "paneGap",
    "--csat-workspace-pad": "paneBodyPadding",
    "--csat-workspace-target": "minTarget",
    "--csat-workspace-icon": "dockIcon",
    "--csat-workspace-icon-face": "dockIconFace",
    "--csat-workspace-name": "dockNameFont",
    "--csat-workspace-question": "questionFont",
    "--csat-workspace-title": "itemTitleFont",
    "--csat-workspace-pane-title": "paneTitleFont"
  }
}
