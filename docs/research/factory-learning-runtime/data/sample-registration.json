    "query": "with m as (select d.id,d.type,d.kind,d.ref_id,d.v_level,d.created_at,a.updated_at source_updated_at,a.content_hash,a.adapted_from_id,a.status source_status,e.source_updated_at cache_updated_at,case when e.article_id is null then 'missing' when e.source_updated_at=a.updated_at then 'fresh' else 'stale' end cache_freshness,jsonb_typeof(d.payload) payload_json_type,jsonb_typeof(d.answer_key) answer_json_type,case when jsonb_typeof(d.payload->'choices')='array' then jsonb_array_length(d.payload->'choices') else null end choice_count,case when jsonb_typeof(d.payload->'underlines')='array' then jsonb_array_length(d.payload->'underlines') else null end underline_count,case when jsonb_typeof(d.payload->'bank')='array' then jsonb_array_length(d.payload->'bank') else null end bank_count,coalesce(length(d.answer_key->>'explanation_ko'),0)>0 explanation_present,case when d.type in ('unit_vocab','unit_grammar') then jsonb_typeof(d.payload->'choices')='array' and jsonb_array_length(d.payload->'choices')>=2 when d.type in ('vocab_choice','grammar_choice') then jsonb_typeof(d.payload->'underlines')='array' and jsonb_array_length(d.payload->'underlines')>=2 when d.type='word_order' then jsonb_typeof(d.payload->'bank')='array' and jsonb_array_length(d.payload->'bank')>=2 else jsonb_typeof(d.payload->'stem')='string' end structure_present from csat_dcp_items d left join library_articles a on d.kind='article' and a.id=d.ref_id left join csat_source_eligibility e on e.article_id=d.ref_id where d.type in ('vocab_choice','unit_vocab','blank_word','grammar_choice','grammar_fix','unit_grammar','word_order') and d.ref_id not in ('c359d555-470e-4e9f-87ae-baeba0c45580','ef55d014-1beb-4c66-9b0f-5e0d93c4ce2b','961b265e-70d6-4416-9841-fffa7c73e647','36b6dbf4-5c4b-49d6-80a0-cc747b73a64f','60f8db31-25bd-4925-8ad5-d9b1cba8d522','ed196b6e-afb5-4db0-b96a-32ee6bf9cf20','f426ce78-2fad-46d2-922e-c5d5d8fb5189','962cab19-15ff-473d-b1d5-d3dc27d194ab','89b96656-3dbf-4761-bc9f-aad52cb92d25','efd