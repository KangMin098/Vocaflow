        "definition": "CHECK ((event = ANY ('{catalog_viewed,csat_atlas_scoped,csat_browse_filtered,csat_drill_answered,csat_drill_finished,csat_dx_attempt_saved,csat_dx_habit_answered,csat_dx_history_compared,csat_dx_profile_saved,csat_dx_test_submitted,csat_dx_viewed,csat_ec_capture_closed,csat_ec_capture_finished,csat_ec_capture_opened,csat_evidence_opened,csat_factory_dcp_opened,csat_factory_dcp_requested,csat_factory_dcp_returned,csat_factory_dcp_submitted,csat_home_viewed,csat_item_back,csat_item_opened,csat_learning_error,csat_lecture_ended,csat_lecture_played,csat_map_goal_set,csat_map_node_opened,csat_map_task_toggled,csat_map_viewed,csat_meaning_bridge_followed,csat_meaning_depth_changed,csat_meaning_draft_compared,csat_meaning_relation_opened,csat_meaning_unit_selected,csat_meaning_whole_traced,csat_overlay_answered,csat_overlay_loaded,csat_overlay_located,csat_overlay_revealed,csat_paper_failed,csat_paper_read,csat_path_chosen,csat_plan_ordered,csat_plan_speed_set,csat_prediction_skipped,csat_prediction_submitted,csat_principle_saved,csat_resume_clicked,csat_review_completed,csat_review_done,csat_review_scheduled,csat_review_started,csat_session_answered,csat_session_completed,csat_session_explained,csat_session_finished,csat_session_marked,csat_session_started,csat_source_lesson_reflected,csat_source_ready,csat_space_opened,csat_space_scoped,csat_step_advanced,csat_transfer_submitted,csat_trap_opened,csat_workspace_created,csat_workspace_edited,csat_workspace_opened,csat_workspace_session_started,csat_workspace_suggestion_applied,fit_analyzed,fit_level_moved,fit_share_opened,fit_shared,fit_sheet_opened,fit_signup_clicked,fit_viewed,fit_worksheet_printed,hub_hero_moved,hub_promo_clicked,invite_shared,knowledge_task_submitted,knowledge_task_viewed,landing_cta_clicked,landing_demo_moved,landing_section_reached,landing_viewed,screen_viewed,teacher_hub_view,video_completed,video_started,volume_previewed,wayfinder_cta_clicked,wayfinder_opened}'::text[])))"
      },
      {
        "name": "content_qualification_annotation_bound",
        "table": "content_qualification",
        "definition": "CHECK (((artifact_kind <> 'csat_item'::text) OR (NOT ((((axes -> 'B'::text) ->> 'state'::text) = 'pass'::text) OR (((axes -> 'C'::text) ->> 'state'::text) = 'pass'::text) OR (((axes -> 'E'::text) ->> 'state'::text) = 'pass'::text))) OR ((annotation_ref IS NOT NULL) AND (annotation_hash IS NOT NULL))))"
      },
      {
        "name": "content_qualification_annotation_hash_check",
        "table": "content_qualification",
        "definition": "CHECK (((annotation_hash IS NULL) OR (annotation_hash ~ '^[0-9a-f]{64}$'::text)))"
      },
      {
        "name": "content_qualification_annotation_ref_check",
        "table": "content_qualification",
        "definition": "CHECK (((annotation_ref IS NULL) OR ((length(btrim(annotation_ref)) >= 1) AND (length(btrim(annotation_ref)) <= 200))))"
      },
      {
        "name": "content_qualification_artifact_kind_check",
        "table": "content_qualification",
        "definition": "CHECK ((artifact_kind = ANY (ARRAY['dcp_item'::text, 'csat_item'::text, 'textbook_activity'::text, 'workspace_bundle'::text, 'authored_item'::text])))"
      },
      {
        "name": "content_qualification_artifact_ref_check",
        "table": "content_qualification",
        "definition": "CHECK (((length(artifact_ref) >= 1) AND (length(artifact_ref) <= 200)))"
      },
      {
        "name": "content_qualification_artifact_revision_check",
        "table": "content_qualification",
        "definition": "CHECK (((length(artifact_revision) >= 1) AND (length(artifact_revision) <= 128)))"
      },
      {
        "name": "content_qualification_authored_bound",
        "table": "content_qualification",
        "definition": "CHECK (((artifact_kind <> 'authored_item'::text) OR ((annotation_ref IS NOT NULL) AND (annotation_hash IS NOT NULL))))"
      },
      {
        "name": "content_qualification_axes_check",
        "table": "content_qualification",
        "definition": "CHECK (fq_axes_valid(axes))"
      },
      {
        "name": "content_qualification_check",
        "table": "content_qualification",
        "definition": "CHECK (((((axes -> 'A'::text) ->> 'state'::text) <> 'pass'::text) OR ((source_revision IS NOT NULL) AND (source_hash IS NOT NULL))))"
      },
      {
        "name": "content_qualification_check1",
        "table": "content_qualification",
        "definition": "CHECK (((((axes -> 'E'::text) ->> 'state'::text) <> 'pass'::text) OR ((gold_revision IS NOT NULL) AND (gold_hash IS NOT NULL))))"
      },
      {
        "name": "content_qualification_gold_hash_check",
        "table": "content_qualification",
        "definition": "CHECK (((gold_hash IS NULL) OR (gold_hash ~ '^[0-9a-f]{64}$'::text)))"
