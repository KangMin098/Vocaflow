  "sensitive_content": [
    {
      "id": "se-no-place-for-a-girl",
      "anchors": [
        {
          "source_sha256": "b314858a538c5f419540cbb87144ebde9aad18727015cd86d4db786632ef88b7",
          "paragraph": 2,
          "start": 616,
          "end": 653,
          "quote": "'A lighthouse is no place for a girl."
        }
      ],
      "issue": "당시의 성차별적 고정관념을 담은 말이다.",
      "handling": "retain_with_context",
      "rationale": "이야기의 갈등과 반어(proper keeper)의 출발점이라 지우면 의미가 사라진다. 그대로 두고 그 생각을 이야기가 뒤집는다는 맥락 설명을 붙인다."
    }
  ],
  "entry_scene": {
    "anchors": [
      {
        "source_sha256": "b314858a538c5f419540cbb87144ebde9aad18727015cd86d4db786632ef88b7",
        "paragraph": 0,
        "start": 0,
        "end": 172,
        "quote": "Upon the bleak shoulder of Gull Rock there stood a lighthouse, and in the lighthouse dwelt old Tobias Wren and his granddaughter Mara, who was then but twelve years of age."
      },
      {
        "source_sha256": "b314858a538c5f419540cbb87144ebde9aad18727015cd86d4db786632ef88b7",
        "paragraph": 1,
        "start": 174,
        "end": 476,
        "quote": "Each evening Tobias climbed the winding stair to kindle the great lamp, and each evening Mara counted the steps aloud, for she had resolved to know the tower as well as he did. 'One hundred and nine,' she would say, 'and the ninth is cracked.' Her grandfather laughed at this, but he did not forget it."
      }
    ],
    "spoiler_free": true,
    "rationale": "등대 · 인물 · 계단 세기만 보여 준다. 폭풍 · 사고 · 결말을 드러내지 않는다."
  },
  "review_concerns": [
