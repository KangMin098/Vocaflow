{
  "view": " SELECT i.id,\n    i.exam_id,\n    i.no,\n    i.section,\n    i.in_scope,\n    i.type_id,\n    i.stem,\n        CASE\n            WHEN csat_ec_private.item_answer_embargoed(i.id) THEN NULL::integer\n            ELSE i.answer\n        END AS answer,\n    i.points,\n    i.high_score,\n    e.organizer,\n    e.grade\n   FROM csat_items i\n     JOIN csat_exams e ON e.id = i.exam_id\n  WHERE e.organizer = 'kice'::text OR e.organizer = 'edu_office'::text AND (EXISTS ( SELECT 1\n           FROM csat_item_analyses a\n          WHERE a.item_id = i.id AND a.status = 'published'::text));",
