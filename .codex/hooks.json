{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/scripts/guard.mjs\" --agent claude",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agents/scripts/handoff-inject.mjs\" --agent claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
